# Copy jadi .env  ->  `cp .env.example .env`  (JANGAN commit .env)

# --- Umum --------------------------------------------------------------------
REDIS_CONTAINER_NAME=redis

# --- Auth (WAJIB di production) ----------------------------------------------
# Generate yang kuat, contoh: `openssl rand -base64 32`
REDIS_PASSWORD=ganti_dengan_password_yang_kuat

# --- Memory (production) -----------------------------------------------------
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- Dev only ----------------------------------------------------------------
REDIS_COMMANDER_PORT=8081
